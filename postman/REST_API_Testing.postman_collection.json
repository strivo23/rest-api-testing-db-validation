            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid severity defect\",\n  \"description\": \"Severity must be Low, Medium, High or Critical.\",\n  \"severity\": \"Blocker\",\n  \"status\": \"Open\",\n  \"category\": \"API\",\n  \"environment\": \"Web\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "POST /issues with severity \"Blocker\" - not one of Low, Medium, High, Critical."
          },
          "response": []
