              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ab\",\n  \"severity\": \"Low\",\n  \"status\": \"Open\",\n  \"category\": \"UI\",\n  \"environment\": \"Web\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
