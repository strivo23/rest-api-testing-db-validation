{
  "info": {
    "_postman_id": "8f1c2f4e-4c1b-4a1e-9f0d-2b7c5a6d10aa",
    "name": "REST API Testing & Database Validation",
    "description": "API test collection for the REST API Testing & Database Validation Platform (FastAPI + PostgreSQL defect tracker).\n\nHow to use:\n1. Start the API locally: `uvicorn app.main:app --reload` (default http://127.0.0.1:8000).\n2. In Postman open Collections > Import and select this file (postman/REST_API_Testing.postman_collection.json).\n3. Check the collection variable `baseUrl` (Collection > Variables) - the default is http://127.0.0.1:8000.\n4. Run the whole collection with the Collection Runner (or `newman run postman/REST_API_Testing.postman_collection.json`).\n   Keep the requests in the default order: the Update/Delete folder reuses the id captured by \"02 - Create a valid defect\".\n   Every request can also be sent individually - requests that need an id create one through their pre-request script.\n5. No test depends on a hardcoded database id; ids are captured from responses into collection variables.\n\nShared collection variables:\n- baseUrl      : API base URL\n- issueId      : id captured from the \"create valid defect\" request and reused for read/update/delete\n- severityIssueIds : ids created by the all-severities sweep\n- deletedIssueId   : id used to verify that a deleted defect is really gone",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection level pre-request script: make sure baseUrl always has a value.",
          "if (!pm.collectionVariables.get(\"baseUrl\")) {",
          "    pm.collectionVariables.set(\"baseUrl\", \"http://127.0.0.1:8000\");",
          "}",
          "// Fail fast with a readable message when the API is not running.",
          "pm.test(\"baseUrl collection variable is configured\", function () {",
          "    pm.expect(pm.collectionVariables.get(\"baseUrl\")).to.be.a(\"string\").and.to.not.be.empty;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "issueId",
      "value": "",
      "type": "string"
    },
    {
      "key": "severityIssueIds",
      "value": "",
      "type": "string"
    },
    {
      "key": "deletedIssueId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Smoke",
      "description": "Verify that the API is up and that the database connection is healthy.",
      "item": [
        {
          "name": "01 - Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response content type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response contains the expected fields\", function () {",
                  "    pm.expect(body).to.have.property(\"status\");",
                  "    pm.expect(body).to.have.property(\"database\");",
                  "    pm.expect(body).to.have.property(\"version\");",
                  "});",
                  "",
                  "pm.test(\"API status is ok\", function () {",
                  "    pm.expect(body.status).to.eql(\"ok\");",
                  "});",
                  "",
                  "pm.test(\"Database connection is healthy\", function () {",
                  "    pm.expect(body.database).to.eql(\"connected\");",
                  "    pm.expect(body.dialect).to.be.oneOf([\"postgresql\", \"sqlite\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "GET /health - returns 200 when the API and database are available, 503 when the database is unreachable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Create Defects",
      "description": "Positive creation scenarios, including every supported severity value.",
      "item": [
        {
          "name": "02 - Create a valid defect",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response content type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"A numeric id was generated\", function () {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.id).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"All submitted fields are echoed back\", function () {",
                  "    pm.expect(body.title).to.eql(\"Login button unresponsive on Android 13\");",
                  "    pm.expect(body.severity).to.eql(\"High\");",
                  "    pm.expect(body.status).to.eql(\"Open\");",
                  "    pm.expect(body.category).to.eql(\"Functional\");",
                  "    pm.expect(body.environment).to.eql(\"Android\");",
                  "    pm.expect(body.description).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Timestamps are present and identical on creation\", function () {",
                  "    pm.expect(body.created_at).to.be.a(\"string\");",
                  "    pm.expect(body.updated_at).to.be.a(\"string\");",
                  "    pm.expect(body.created_at).to.eql(body.updated_at);",
                  "});",
                  "",
                  "// Capture the generated id so the read/update/delete requests can reuse it.",
                  "pm.collectionVariables.set(\"issueId\", body.id);",
                  "pm.collectionVariables.set(\"deletedIssueId\", \"\");",
                  "console.log(\"Captured issueId = \" + body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Login button unresponsive on Android 13\",\n  \"description\": \"Tapping the Log in button does not submit the form.\",\n  \"severity\": \"High\",\n  \"status\": \"Open\",\n  \"category\": \"Functional\",\n  \"environment\": \"Android\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "POST /issues - creates a defect and returns 201 with the generated id. The id is stored in the collection variable `issueId`."
          },
          "response": []
        },
        {
          "name": "03 - Create a defect with every supported severity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const severities = [\"Low\", \"Medium\", \"High\", \"Critical\"];",
                  "const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
                  "const createdIds = {};",
                  "",
                  "// This test script itself creates one defect per severity and verifies each one.",
                  "const createOne = function (severity) {",
                  "    return pm.sendRequest({",
                  "        url: baseUrl + \"/issues\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({",
                  "                title: \"Severity sweep - \" + severity + \" defect example\",",
                  "                description: \"Created by the Postman severity sweep.\",",
                  "                severity: severity,",
                  "                status: \"Open\",",
                  "                category: \"API\",",
                  "                environment: \"Backend API\"",
                  "            })",
                  "        }",
                  "    }).then(function (response) {",
                  "        pm.test(\"Severity '\" + severity + \"' is accepted with 201\", function () {",
                  "            pm.expect(response.code).to.eql(201);",
                  "        });",
                  "        pm.test(\"Defect created with severity '\" + severity + \"'\", function () {",
                  "            pm.expect(response.json().severity).to.eql(severity);",
                  "        });",
                  "        createdIds[severity] = response.json().id;",
                  "    });",
                  "};",
                  "",
                  "// Chain the requests so the collection variable is stored after the last one.",
                  "createOne(severities[0])",
                  "    .then(function () { return createOne(severities[1]); })",
                  "    .then(function () { return createOne(severities[2]); })",
                  "    .then(function () { return createOne(severities[3]); })",
                  "    .then(function () {",
                  "        pm.collectionVariables.set(\"severityIssueIds\", JSON.stringify(createdIds));",
                  "        pm.test(\"Every supported severity was created\", function () {",
                  "            pm.expect(Object.keys(createdIds)).to.have.members(severities);",
                  "        });",
                  "    });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Severity sweep - Critical defect example\",\n  \"description\": \"Created by the Postman severity sweep request.\",\n  \"severity\": \"Critical\",\n  \"status\": \"Open\",\n  \"category\": \"API\",\n  \"environment\": \"Backend API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "POST /issues for every severity value (Low, Medium, High, Critical). The request itself sends the Critical payload; the test script additionally creates and verifies one defect per severity and stores their ids in `severityIssueIds`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Validation (negative)",
      "description": "Input validation and negative scenarios that must return 422 with a consistent error body.",
      "item": [
        {
          "name": "04 - Create a defect with missing required fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Error response follows the documented contract\", function () {",
                  "    pm.expect(body).to.have.property(\"error\");",
                  "    pm.expect(body.error.type).to.eql(\"validation_error\");",
                  "    pm.expect(body.error.message).to.be.a(\"string\");",
                  "    pm.expect(body.error.details).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Every required field is reported as missing\", function () {",
                  "    const fields = body.error.details.map(function (item) { return item.field; });",
                  "    [\"title\", \"severity\", \"status\", \"category\", \"environment\"].forEach(function (field) {",
                  "        pm.expect(fields).to.include(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"No stack trace or internals leak into the response\", function () {",
                  "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"traceback\");",
                  "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"sqlalchemy\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Only the optional field is provided.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "description": "POST /issues with an empty payload (only the optional description) - expects 422 and a field level error list."
          },
          "response": []
        },
        {
          "name": "05 - Create a defect with an invalid severity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Severity is reported as an invalid value\", function () {",
                  "    pm.expect(body.error.type).to.eql(\"validation_error\");",
                  "    const details = body.error.details;",
                  "    pm.expect(details.some(function (item) { return item.field === \"severity\"; })).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"No defect is created with an invalid severity\", function () {",
                  "    pm.expect(body).to.not.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
