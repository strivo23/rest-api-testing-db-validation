                  "});",
                  "",
                  "pm.test(\"Response content type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Not found error follows the documented contract\", function () {",
                  "    pm.expect(body.error.type).to.eql(\"not_found\");",
                  "    pm.expect(body.error.message).to.include(\"999999\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "999999"
              ]
            },
            "description": "GET /issues/999999 - a deliberately unused id (not a hardcoded production record)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Update & Delete",
      "description": "Partial update, invalid update and deletion scenarios. These requests reuse the id captured by request 02.",
      "item": [
        {
          "name": "10 - Update a defect status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const issueId = pm.collectionVariables.get(\"issueId\");",
                  "",
                  "pm.test(\"The status was updated\", function () {",
                  "    pm.expect(body.status).to.eql(\"In Progress\");",
                  "});",
                  "",
                  "pm.test(\"Other fields are unchanged\", function () {",
                  "    pm.expect(body.severity).to.be.a(\"string\");",
                  "    pm.expect(body.created_at).to.be.a(\"string\");",
                  "    pm.expect(body.title).to.be.a(\"string\");",
                  "});",
                  "console.log(\"Updated defect \" + issueId);",
                  "",
                  "// Independent verification: read the record back and check that the change persisted.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/issues/\" + issueId,",
                  "    method: \"GET\"",
                  "}).then(function (response) {",
                  "    pm.test(\"The update is persisted (verified with a follow-up GET)\", function () {",
                  "        pm.expect(response.code).to.eql(200);",
                  "        pm.expect(response.json().status).to.eql(\"In Progress\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "description": "PATCH /issues/{id} - partial update of the status field only."
          },
          "response": []
        },
        {
          "name": "11 - Update a defect with invalid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"The invalid update is rejected with field details\", function () {",
                  "    pm.expect(body.error.type).to.eql(\"validation_error\");",
                  "    pm.expect(body.error.details).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "// The rejected update must not change the stored record.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/issues/\" + pm.collectionVariables.get(\"issueId\"),",
                  "    method: \"GET\"",
                  "}).then(function (response) {",
                  "    pm.test(\"The stored defect is unchanged after the failed update\", function () {",
                  "        pm.expect(response.code).to.eql(200);",
                  "        pm.expect([\"Low\", \"Medium\", \"High\", \"Critical\"]).to.include(response.json().severity);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"Blocker\",\n  \"title\": \"ab\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "description": "PATCH /issues/{id} with an unsupported severity and a too-short title - both must be rejected."
          },
          "response": []
        },
        {
          "name": "12 - Delete a defect",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Standalone safety: deleting a nonexistent id would return 404 instead of 204.",
                  "if (!pm.collectionVariables.get(\"issueId\")) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get(\"baseUrl\") + \"/issues\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({",
                  "                title: \"Temporary defect for deletion test\",",
                  "                severity: \"Medium\",",
                  "                status: \"Open\",",
                  "                category: \"API\",",
                  "                environment: \"Web\"",
                  "            })",
                  "        }",
                  "    }, function (error, response) {",
                  "        if (!error && response.code === 201) {",
                  "            pm.collectionVariables.set(\"issueId\", response.json().id);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test(\"The response body is empty\", function () {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});",
                  "",
                  "// Remember which id was deleted so request 13 can verify it is gone.",
                  "pm.collectionVariables.set(\"deletedIssueId\", pm.collectionVariables.get(\"issueId\"));",
                  "console.log(\"Deleted issueId = \" + pm.collectionVariables.get(\"deletedIssueId\"));",
                  "",
                  "// Free the issueId variable: the next create request must capture a fresh id.",
                  "pm.collectionVariables.set(\"issueId\", \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "description": "DELETE /issues/{id} - expects 204 with an empty body. The deleted id is stored in `deletedIssueId`."
          },
          "response": []
        },
        {
          "name": "13 - Retrieve a deleted defect",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// When this request is sent on its own, use an id that cannot exist.",
                  "if (!pm.collectionVariables.get(\"deletedIssueId\")) {",
                  "    pm.collectionVariables.set(\"deletedIssueId\", \"999999\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"The deleted defect no longer exists\", function () {",
                  "    pm.expect(body.error.type).to.eql(\"not_found\");",
                  "    pm.expect(body.error.message).to.include(pm.collectionVariables.get(\"deletedIssueId\"));",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"deletedIssueId\", \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/{{deletedIssueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{deletedIssueId}}"
              ]
            },
            "description": "GET /issues/{id} for the id deleted by request 12 - must return 404 (data-consistency check)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Filter, Pagination & Statistics",
      "description": "Query parameters, sorting, pagination boundaries and the aggregated statistics endpoint.",
      "item": [
        {
          "name": "14 - Filter defects by severity and status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Pagination metadata is present\", function () {",
                  "    pm.expect(body).to.have.property(\"total\");",
                  "    pm.expect(body.items).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Only defects matching the filter are returned\", function () {",
                  "    body.items.forEach(function (item) {",
                  "        pm.expect(item.severity).to.eql(\"Critical\");",
                  "        pm.expect(item.status).to.eql(\"Open\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"The reported total matches the filtered result set\", function () {",
                  "    pm.expect(body.total).to.be.a(\"number\");",
                  "});",
                  "",
                  "// Negative filter: an unmatched severity must return an empty page.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/issues?severity=Critical&status=Closed&search=no-such-defect-xyz\",",
                  "    method: \"GET\"",
                  "}).then(function (response) {",
                  "    pm.test(\"An unmatched filter returns an empty page\", function () {",
                  "        pm.expect(response.code).to.eql(200);",
                  "        pm.expect(response.json().total).to.eql(0);",
                  "        pm.expect(response.json().items).to.be.an(\"array\").that.is.empty;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?severity=Critical&status=Open&page=1&page_size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "severity",
                  "value": "Critical"
                },
                {
                  "key": "status",
                  "value": "Open"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "GET /issues filtered by severity and status (created by request 03)."
          },
          "response": []
        },
        {
          "name": "15 - Test pagination and sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Page metadata reflects the request\", function () {",
                  "    pm.expect(body.page).to.eql(1);",
                  "    pm.expect(body.page_size).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"The page never contains more items than the page size\", function () {",
                  "    pm.expect(body.items.length).to.be.at.most(2);",
                  "});",
                  "",
                  "pm.test(\"Items are sorted by id descending\", function () {",
                  "    const ids = body.items.map(function (item) { return item.id; });",
                  "    const sorted = ids.slice().sort(function (a, b) { return b - a; });",
                  "    pm.expect(ids).to.eql(sorted);",
                  "});",
                  "",
                  "// Second page must not repeat records from the first page.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/issues?page=2&page_size=2&sort_by=id&order=desc\",",
                  "    method: \"GET\"",
                  "}).then(function (response) {",
                  "    pm.test(\"Page 2 returns a different, non-overlapping set\", function () {",
                  "        pm.expect(response.code).to.eql(200);",
                  "        const firstIds = body.items.map(function (item) { return item.id; });",
                  "        const secondIds = response.json().items.map(function (item) { return item.id; });",
                  "        secondIds.forEach(function (id) {",
                  "            pm.expect(firstIds).to.not.include(id);",
                  "        });",
                  "    });",
                  "});",
                  "",
                  "// Boundary check: an out-of-range page size must be rejected.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/issues?page_size=1000\",",
                  "    method: \"GET\"",
                  "}).then(function (response) {",
                  "    pm.test(\"page_size above the maximum returns 422\", function () {",
                  "        pm.expect(response.code).to.eql(422);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?page=1&page_size=2&sort_by=id&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "2"
                },
                {
                  "key": "sort_by",
                  "value": "id"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            },
            "description": "GET /issues with pagination, sorting and boundary checks."
          },
          "response": []
        },
        {
          "name": "16 - Retrieve defect statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Statistics contain all documented buckets\", function () {",
                  "    pm.expect(Object.keys(body)).to.have.members([\"total\", \"by_status\", \"by_severity\"]);",
                  "    pm.expect(Object.keys(body.by_status)).to.have.members([\"Open\", \"In Progress\", \"Closed\"]);",
                  "    pm.expect(Object.keys(body.by_severity)).to.have.members([\"Low\", \"Medium\", \"High\", \"Critical\"]);",
                  "});",
                  "",
                  "pm.test(\"Status counts add up to the total\", function () {",
                  "    const sum = body.by_status.Open + body.by_status[\"In Progress\"] + body.by_status.Closed;",
                  "    pm.expect(sum).to.eql(body.total);",
                  "});",
                  "",
                  "pm.test(\"Severity counts add up to the total\", function () {",
                  "    const sum = body.by_severity.Low + body.by_severity.Medium + body.by_severity.High + body.by_severity.Critical;",
                  "    pm.expect(sum).to.eql(body.total);",
                  "});",
                  "",
                  "pm.test(\"All counts are non-negative numbers\", function () {",
                  "    pm.expect(body.total).to.be.at.least(0);",
                  "    Object.values(body.by_status).forEach(function (value) { pm.expect(value).to.be.at.least(0); });",
                  "    Object.values(body.by_severity).forEach(function (value) { pm.expect(value).to.be.at.least(0); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "stats"
              ]
            },
            "description": "GET /issues/stats - counts grouped by status and severity."
          },
          "response": []
        }
      ]
    }
