# ---------------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholders with local values.
# NEVER commit the real .env file (it is already listed in .gitignore).
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the application.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:<your_password>@localhost:5432/defect_tracker

# Set to "true" to echo SQL statements to the console (useful while debugging).
DB_ECHO=false

# Connection pool tuning (ignored for SQLite URLs).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional: comma separated list of allowed CORS origins ("*" allows all).
CORS_ORIGINS=*

# Optional: create tables automatically on application start-up (handy for a
# first run, but the documented way is "python -m app.db_init").
AUTO_CREATE_TABLES=false

# Optional: used only by the PostgreSQL integration test suite.
# When it is empty the integration tests are skipped automatically.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:<your_password>@localhost:5432/defect_tracker_test
